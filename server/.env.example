# ============================================================
# StayEase Backend – Environment Variables Template
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env to version control.
# ============================================================

# ────────────────────────────────────────────────────────────
# Core Server Configuration
# ────────────────────────────────────────────────────────────
# Port where backend Express server listens (StayEase uses 5001)
PORT=5001

# Environment: "development" | "production" | "test"
NODE_ENV=development

# Client URL (frontend application address)
CLIENT_URL=http://localhost:5173

# Allowed CORS Origin(s)
CORS_ORIGIN=http://localhost:5173

# ────────────────────────────────────────────────────────────
# MongoDB Database Configuration
# ────────────────────────────────────────────────────────────
# MongoDB Connection URI (e.g. Atlas cluster or local mongod)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local format: mongodb://127.0.0.1:27017/stayease
MONGODB_URI=

# Database Connection Policy:
# DB_REQUIRED: Set to "true" in production or when MongoDB connection is mandatory.
# When "true", server startup aborts if MongoDB fails to connect.
# When "false" (default in dev), server falls back to server/data/db.json.
DB_REQUIRED=false

# ALLOW_JSON_FALLBACK: Set to "true" to enable local JSON database (server/data/db.json) in development.
ALLOW_JSON_FALLBACK=true

# ────────────────────────────────────────────────────────────
# Authentication & JWT Secrets
# ────────────────────────────────────────────────────────────
# Secret used for signing short-lived access tokens (min 32 chars)
JWT_SECRET=REPLACE_WITH_A_STRONG_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=15m

# Secret used for signing long-lived refresh tokens (min 32 chars)
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_STRONG_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ────────────────────────────────────────────────────────────
# Google OAuth Configuration
# ────────────────────────────────────────────────────────────
# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=

# ────────────────────────────────────────────────────────────
# Razorpay Payment Gateway (Phase 4)
# ────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXX

# ────────────────────────────────────────────────────────────
# Cloudinary Media Storage (Optional)
# ────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ────────────────────────────────────────────────────────────
# Email Notification Service (SMTP)
# ────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=StayEase <noreply@stayease.com>
